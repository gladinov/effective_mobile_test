ENV=dev # "local", "dev", "prod"
# Server adress
HOST=0.0.0.0
PORT=8080

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=parol
POSTGRES_DB=subscriptions
POSTGRES_PORT=5434 
SSLMODE=disable

# Timeouts
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=7s

APP_CLOSE_TIMEOUT=3s
REQUEST_TIMEOUT=5s
DB_QUERY_TIMEOUT=3s
DB_CONNECT_TIMEOUT=5s
